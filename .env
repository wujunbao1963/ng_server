#
# ================================
# NeighborGuard ng_server
# Environment Variables (Example)
# ================================
#

# --------------------------------
# Server
# --------------------------------

# Server listening port
# (Local dev can override with PORT=xxxx npm run start)
PORT=3000


# --------------------------------
# Database (PostgreSQL)
# --------------------------------

# Full PostgreSQL connection URL
# Example (Railway / Neon / Supabase):
# postgres://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:DiTqEOiVsMEiKQRyIcQPskAGDBXuzvxH@turntable.proxy.rlwy.net:24506/railway

# Enable SSL when connecting to DB
# true for Railway / cloud DB
DB_SSL=true

# Reject unauthorized SSL certs
# false is often required for Railway / managed DBs
DB_SSL_REJECT_UNAUTHORIZED=false


# --------------------------------
# Authentication / Security
# --------------------------------

# JWT secret for app-side authentication
# CHANGE THIS IN PRODUCTION
JWT_SECRET=dev-jwt-secret

# Pepper used to derive device keys (edge authentication)
# CHANGE THIS IN PRODUCTION
DEVICE_KEY_PEPPER=dev-device-pepper


# --------------------------------
# Runtime / Environment
# --------------------------------

# Node environment
NODE_ENV=development


# --------------------------------
# Optional: Logging / Debug
# --------------------------------

# Set to true to enable extra debug logs (if used)
# DEBUG=true


# --------------------------------
# Push Notifications
# --------------------------------

# Web Push (Browser notifications) - VAPID Configuration
# Generate keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key
# VAPID_SUBJECT=mailto:admin@example.com

# iOS Native Push (APNs) Configuration
# Obtain from Apple Developer Account:
# 1. Create an APNs Key (.p8 file) in Apple Developer Portal
# 2. Note the Key ID and Team ID
# 3. Either provide the path to the .p8 file or paste its content
# APNS_KEY_ID=your-key-id
# APNS_TEAM_ID=your-team-id
# APNS_KEY_PATH=/path/to/AuthKey_KEYID.p8
# Or use APNS_KEY_CONTENT to paste the key content directly:
# APNS_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\nMIGT...your key here...\n-----END PRIVATE KEY-----
# APNS_BUNDLE_ID=com.neighbor-guard.app
# APNS_PRODUCTION=false
